// CapyCut: badges and emoji, the other half of the Stickers page. The figures
// above them are shapes; these are the things a video wears - SUBSCRIBE, LIKE,
// a bell - and the reaction an editor drops on a beat.
//
// An emoji card places a title whose words are the emoji: the interface already
// draws emoji from a COLR face, so there is no asset here and nothing to
// download. A badge card places two clips - the pill from the Shapes shelf and
// its word on top - which is one batch and one undo step. See
// Studio::place_sticker.

import { I18n } from "../i18n.slint";
import { Theme } from "../theme/theme.slint";

export struct StickerCardData {
    /// What the click sends: "badge:subscribe", "emoji:😀".
    id: string,
    /// The accessible label under nothing - kept for the tooltip.
    label: string,
    /// What the card draws: the badge's word, or the emoji itself.
    sample: string,
}

export component StickerGrid inherits VerticalLayout {
    callback placed(id: string);

    in property <[StickerCardData]> stickers: [
        { id: "badge:SUBSCRIBE", label: I18n.t("stickerPanel.subscribe"), sample: "SUBSCRIBE" },
        { id: "badge:LIKE", label: I18n.t("stickerPanel.like"), sample: "👍 LIKE" },
        { id: "badge:SHARE", label: I18n.t("stickerPanel.share"), sample: "SHARE" },
        { id: "badge:BELL", label: I18n.t("stickerPanel.bell"), sample: "🔔 ALL" },
        { id: "badge:COMMENT", label: I18n.t("stickerPanel.comment"), sample: "COMMENT" },
        { id: "badge:FOLLOW", label: I18n.t("stickerPanel.follow"), sample: "FOLLOW" },
        { id: "emoji:😀", label: "grin", sample: "😀" },
        { id: "emoji:😂", label: "laugh", sample: "😂" },
        { id: "emoji:😮", label: "wow", sample: "😮" },
        { id: "emoji:😍", label: "love", sample: "😍" },
        { id: "emoji:🔥", label: "fire", sample: "🔥" },
        { id: "emoji:❤️", label: "heart", sample: "❤️" },
        { id: "emoji:✅", label: "check", sample: "✅" },
        { id: "emoji:❌", label: "cross", sample: "❌" },
        { id: "emoji:⭐", label: "star", sample: "⭐" },
        { id: "emoji:✨", label: "sparkle", sample: "✨" },
        { id: "emoji:⚠️", label: "warn", sample: "⚠️" },
        { id: "emoji:❓", label: "question", sample: "❓" },
        { id: "emoji:👆", label: "point up", sample: "👆" },
        { id: "emoji:👉", label: "point right", sample: "👉" },
    ];

    spacing: 6px;
    padding-top: 10px;

    Text {
        text: I18n.t("stickerPanel.title");
        color: Theme.fg-muted;
        font-size: Theme.fs-sm;
        height: 18px;
    }

    GridLayout {
        spacing: 6px;

        for card[index] in root.stickers: Rectangle {
            row: Math.floor(index / 4);
            col: Math.mod(index, 4);
            height: 40px;
            border-radius: Theme.r;
            background: Theme.field;
            border-width: 1px;
            border-color: Theme.line;

            Text {
                text: card.sample;
                color: Theme.fg;
                font-size: 13px;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }

            touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.placed(card.id); }
            }
        }
    }
}
