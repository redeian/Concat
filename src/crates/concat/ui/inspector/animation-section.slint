// CapyCut: one-click animation for the things that are not footage - titles,
// figures, and the stickers built from either.
//
// A preset is a short list of keyframes on the clip's own scale, opacity,
// offset and rotation, applied as one batch: see animation.rs. Nothing here
// animates; the panel only sends which preset, and which part of the clip it
// belongs to.
//
// Three groups, because that is what an edit is: how it arrives, what it does
// while it is there, and how it leaves. The arrivals and the departures are the
// same presets read in opposite directions, so the same nine names appear twice
// and the side is all that tells them apart.

import { I18n } from "../i18n.slint";
import { Theme } from "../theme/theme.slint";
import { Button } from "../primitives/modal.slint";
import { Param, ParamFormat } from "./controls.slint";

export component AnimationSection inherits VerticalLayout {
    /// Which preset, and which part of the clip: 0 enter, 1 during, 2 exit.
    /// The preset index is global - the looping group starts at 9 - so either
    /// grid can name its preset without knowing which group it is in.
    callback run(preset: int, side: int);
    /// The length an arrival or a departure runs for, in seconds.
    in property <float> seconds: 0.35;
    callback seconds-changed(seconds: float);

    /// CapyCut: the camera group. Only a layer can be a camera, so the caller
    /// says whether the selection can be one and the group appears only then.
    in property <bool> camera: false;
    in property <float> camera-zoom: 1.5;
    in property <float> camera-focus-x: 0.5;
    in property <float> camera-focus-y: 0.5;
    in property <float> camera-move-seconds: 0.3;
    callback camera-punch(side: int);
    callback camera-reset();
    callback camera-param(field: int, value: float);

    /// How many presets come before the looping ones; see `Preset::DURING`.
    property <int> loops-from: 9;

    property <[string]> arrivals: [
        I18n.t("anim.elasticPop"),
        I18n.t("anim.fade"),
        I18n.t("anim.slideUp"),
        I18n.t("anim.slideDown"),
        I18n.t("anim.slideLeft"),
        I18n.t("anim.slideRight"),
        I18n.t("anim.zoom"),
        I18n.t("anim.spin"),
        I18n.t("anim.drop"),
    ];

    property <[string]> loops: [
        I18n.t("anim.pulse"),
        I18n.t("anim.float"),
        I18n.t("anim.shake"),
        I18n.t("anim.breathe"),
    ];

    spacing: 8px;

    Text {
        text: I18n.t("anim.enter");
        color: Theme.fg-muted;
        font-size: Theme.fs-sm;
        height: 16px;
    }

    // A grid rather than a row: nine presets in one line would be a toolbar of
    // unreadable slivers, and this list is going to keep growing.
    GridLayout {
        spacing: 6px;
        for name[index] in root.arrivals: Button {
            row: Math.floor(index / 3);
            col: Math.mod(index, 3);
            label: name;
            block: true;
            clicked => { root.run(index, 0); }
        }
    }

    Text {
        text: I18n.t("anim.during");
        color: Theme.fg-muted;
        font-size: Theme.fs-sm;
        height: 16px;
    }

    GridLayout {
        spacing: 6px;
        for name[index] in root.loops: Button {
            row: Math.floor(index / 2);
            col: Math.mod(index, 2);
            label: name;
            block: true;
            clicked => { root.run(index + root.loops-from, 1); }
        }
    }

    Text {
        text: I18n.t("anim.exit");
        color: Theme.fg-muted;
        font-size: Theme.fs-sm;
        height: 16px;
    }

    GridLayout {
        spacing: 6px;
        for name[index] in root.arrivals: Button {
            row: Math.floor(index / 3);
            col: Math.mod(index, 3);
            label: name;
            block: true;
            clicked => { root.run(index, 2); }
        }
    }

    // CapyCut: the camera. A zoom is a layer whose transform moves, so these
    // controls write keys on scale and offsets - the same keys the curve editor
    // shows - with the hold, move, hold shape a tutorial needs.
    if root.camera: VerticalLayout {
        spacing: 6px;

        Text {
            text: I18n.t("camera.title");
            color: Theme.fg-muted;
            font-size: Theme.fs-sm;
            height: 16px;
        }

        HorizontalLayout {
            spacing: 6px;
            Button {
                label: I18n.t("camera.in");
                block: true;
                clicked => { root.camera-punch(0); }
            }
            Button {
                label: I18n.t("camera.out");
                block: true;
                clicked => { root.camera-punch(1); }
            }
            Button {
                label: I18n.t("camera.reset");
                block: true;
                clicked => { root.camera-reset(); }
            }
        }

        Param {
            label: I18n.t("camera.zoom");
            value: root.camera-zoom;
            minimum: 1;
            maximum: 4;
            step: 0.1;
            default-value: 1.5;
            fmt: ParamFormat.rate;
            changed(v) => { root.camera-param(0, v); }
        }
        Param {
            label: I18n.t("camera.focusX");
            value: root.camera-focus-x;
            minimum: 0;
            maximum: 1;
            step: 0.01;
            default-value: 0.5;
            fmt: ParamFormat.fraction;
            changed(v) => { root.camera-param(1, v); }
        }
        Param {
            label: I18n.t("camera.focusY");
            value: root.camera-focus-y;
            minimum: 0;
            maximum: 1;
            step: 0.01;
            default-value: 0.5;
            fmt: ParamFormat.fraction;
            changed(v) => { root.camera-param(2, v); }
        }
        // How long the reframe takes. Short is right: a camera that drifts is
        // the shape a tutorial looks worse for.
        Param {
            label: I18n.t("camera.move");
            value: root.camera-move-seconds;
            minimum: 0.1;
            maximum: 1;
            step: 0.05;
            default-value: 0.3;
            fmt: ParamFormat.seconds2;
            changed(v) => { root.camera-param(3, v); }
        }
    }

    // How long an arrival or a departure runs. One number for all of them: an
    // edit has one tempo, and a title that pops slower than its neighbour reads
    // as a mistake rather than a choice. The looping presets ignore it - they
    // are the length of the clip by definition.
    Param {
        label: I18n.t("anim.duration");
        value: root.seconds;
        minimum: 0.15;
        maximum: 1.5;
        step: 0.05;
        default-value: 0.35;
        fmt: ParamFormat.seconds2;
        changed(v) => { root.seconds-changed(v); }
    }
}
